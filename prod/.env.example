# --- CREDENTIALS: copy this file to .env and fill in real values ---
DATABASE_URL=postgresql+psycopg2://CHANGE_USER:CHANGE_PASSWORD@db:5432/questions_agent
POSTGRES_USER=CHANGE_USER
POSTGRES_PASSWORD=CHANGE_PASSWORD
REGISTRY_ROOT=/app/registry
API_KEY=change_me
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DB_MIGRATION_MODE=require

# CORS (comma-separated origins, leave empty to disable)
CORS_ALLOWED_ORIGINS=

# AniFold endpoint (only used in SaMD config)
ANIFOLD_ENDPOINT=https://api.ani.ai/anifold/v1
DB_MIGRATION_BASELINE_EXISTING=true

# Site configuration (consumer | cds_default | trial_trial | samd_full)
SITE_CONFIG_DEFAULT=consumer

CORE_QUESTIONS_PER_DAY=5
EXTRA_BATCH_SIZE=5
EXTRA_BATCHES_MAX_PER_DAY=3
ITEM_REPEAT_COOLDOWN_DAYS=7
MAX_ACTIVE_NEW_DOMAINS=2
SAFETY_EVENT_LOOKBACK_DAYS=30
SAFETY_MIN_QUESTIONS_OVERRIDE=3
EMOTION_DEEP_DIVE_ITEM_COUNT=10

# Policy layer (optional)
POLICY_ROOT=/app/policy
POLICY_DEFAULT_VERSION=v1
POLICY_DEFAULT_MODE=policy_shadow
POLICY_EPSILON_EXPLORE=0.05
POLICY_LOG_CONTEXT_SNAPSHOT=true
POLICY_LOG_CANDIDATE_SET_SNAPSHOT=true
POLICY_STORE_Z_SNAPSHOT=false
POLICY_STORE_Z_DELTA=true
POLICY_QUANTIZE_DECIMALS=3
POLICY_AUTO_ROLLBACK_ENABLED=true
POLICY_ROLLBACK_WINDOW_DAYS=14
POLICY_ROLLBACK_MIN_OUTCOMES=40
POLICY_ROLLBACK_MAX_SAFETY_VIOLATIONS=0
POLICY_ROLLBACK_MIN_COMPLETION_DROP=0.03
POLICY_ROLLBACK_BURDEN_INCREASE_RATIO=1.10
DRIFT_ROUTING_TABLE_PATH=

# SLO / alert thresholds
SLO_WINDOW_DAYS=14
SLO_SAFE_FALLBACK_RATE_MAX=0.10
SLO_ANSWER_INGESTION_P95_MS_MAX=750
SLO_SNAPSHOT_WRITE_FAILURE_RATE_MAX=0.01

# PHI controls
PHI_RETENTION_ANSWER_RAW_DAYS=365
PHI_RETENTION_OBSERVATION_RAW_DAYS=365
PHI_RETENTION_POLICY_CONTEXT_DAYS=180
PHI_EXPORT_REDACT_USER_IDS=true
PHI_EXPORT_REDACT_RAW_PAYLOADS=true
PHI_EXPORT_USER_HASH_SALT=CHANGE_ME_RANDOM_SALT
